# Database Credentials
POSTGRES_USER=rentapp
POSTGRES_PASSWORD=rentapp_secure_password
POSTGRES_DB=household_tracker

# Host Port (Change if 8000 is occupied on your host)
PORT=8000

# Authentication & Session Settings
# Set COOKIE_SECURE=true only when serving over HTTPS via a reverse proxy
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Debug flag
DEBUG=false
